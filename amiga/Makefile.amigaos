# Atomic Tanks for GFOS: 68040, libnix, soft float, Allegro 4 from
# gfopenallegro (allegro4.library on acgame.library, 16-bit colour), both in
# the drawer's Libs/ (package/build-amiga.sh builds them at the commits it pins).
#   make -f amiga/Makefile.amigaos PREFIX=<stove>/prefix A4=<gfopenallegro/allegro4> A4OUT=<its build> ACGOUT=<acgame build>
# Copyright (c) 2026 AmiCradle Team. GPL-2 or later, as Atomic Tanks.
PREFIX ?= $(HOME)/AmiCradle/kitchen/stoves/os32-gcc16-open6/prefix
A4 ?= ../gfopenallegro/allegro4
A4OUT ?= $(A4)/build-amiga
ACGOUT ?= ../acgame/build-amiga
CXX = $(PREFIX)/bin/m68k-amigaos-g++
STRIP = $(PREFIX)/bin/m68k-amigaos-strip
NAME = AtomicTanks
VERSION = 6.7
BUILD ?= build/amigaos
DIR = $(BUILD)/$(NAME)

# upstream's sources (Makefile: src/*.cpp), with libnix's missing
# <dirent.h> calls in amiga/dirent_amiga.cpp
SRCS = $(wildcard src/*.cpp) amiga/dirent_amiga.cpp amiga/amiga_start.cpp
OBJS = $(patsubst %.cpp,$(BUILD)/obj/%.o,$(SRCS))
DATA = button misc missile sound stock tank tankgun title text

SOFT = -specs=$(A4)/specs/m68k-soft-m68040.specs
CXXFLAGS = -noixemul -m68040 $(SOFT) -std=gnu++17 -O2 -fomit-frame-pointer \
	-Wall -Wno-unused -Wno-sign-compare \
	-DVERSION=\"$(VERSION)\" -DDATA_DIR=\"PROGDIR:Data\" \
	-Iamiga/compat -Isrc -I$(A4)/include
LIBS = $(A4OUT)/liballeg.a -lpthread -latomic -lm

all: $(DIR)/$(NAME) package

$(BUILD)/$(NAME).debug: $(OBJS)
	$(CXX) -noixemul -m68040 $(SOFT) -o $@ $(OBJS) $(LIBS)

$(DIR)/$(NAME): $(BUILD)/$(NAME).debug
	@mkdir -p $(DIR)
	$(STRIP) -o $@ $<

$(BUILD)/obj/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# The drawer: the game, upstream's data in Data/ as it is, Libs/ with
# allegro4.library and acgame.library, the read-mes and the icons.
package: $(DIR)/$(NAME)
	mkdir -p $(DIR)/Libs $(DIR)/User
	rm -rf $(DIR)/Data
	mkdir -p $(DIR)/Data
	cp -R $(DATA) unicode.dat credits.txt $(DIR)/Data/
	cp $(A4OUT)/allegro4.library $(ACGOUT)/acgame.library $(DIR)/Libs/
	cp AMIGA_PORT.md $(DIR)/ReadMe
	cp README $(DIR)/ReadMe-AtomicTanks
	cp COPYING $(DIR)/COPYING.txt
	cp amiga/Controls amiga/Licences.txt $(DIR)/
	cp amiga/icons/$(NAME).info amiga/icons/ReadMe.info $(DIR)/
	for f in ReadMe-AtomicTanks COPYING.txt Controls Licences.txt; do cp amiga/icons/ReadMe.info $(DIR)/$$f.info; done
	cp amiga/icons/Data.info $(DIR)/User.info
	cp amiga/icons/Data.info $(DIR)/Data.info
	cp amiga/icons/$(NAME)-drawer.info $(BUILD)/$(NAME).info
	cp amiga/Install-$(NAME) amiga/Install-$(NAME).info $(BUILD)/

clean:
	rm -rf $(BUILD)
.PHONY: all package clean
